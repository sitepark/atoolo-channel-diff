{
    "name": "atoolo/channel-diff",
    "description": "CLI tool to compare two IES publication channels.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "veltrup",
            "email": "veltrup@sitepark.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "atoolo/resource-bundle": "^1.8",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "infection/infection": "^0.27.11",
        "overtrue/phplint": "^9.7.1",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Atoolo\\ChannelDiff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoolo\\ChannelDiff\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "scripts": {
        "post-install-cmd": "phive --no-progress install --trust-gpg-keys C00543248C87FB13,4AA394086372C20A,CF1A108D0E7AE720,51C67305FFC2E5C0,E82B2FB314E9906E",
        "analyse": [
            "@analyse:phplint",
            "@analyse:phpstan",
            "@analyse:phpcsfixer",
            "@analyse:compatibilitycheck"
        ],
        "analyse:phplint": "./vendor/bin/phplint",
        "analyse:phpstan": "./tools/phpstan analyse",
        "analyse:phpcsfixer": "./tools/php-cs-fixer check --diff --show-progress=dots",
        "analyse:compatibilitycheck": "./vendor/bin/phpcs --standard=phpcs.xml.dist",
        "fix": [
            "@fix:phpcsfixer"
        ],
        "fix:phpcsfixer": "./tools/php-cs-fixer fix",
        "report": [
            "@report:phpstan"
        ],
        "report:phpstan": "./tools/phpstan analyse --no-progress --no-ansi --no-interaction --error-format=checkstyle > ./var/log/phpstan-report.xml || exit 0",
        "test": [
            "@test:phpunit"
        ],
        "test:phpunit": "./tools/phpunit -c phpunit.xml --coverage-text",
        "test:infection": "vendor/bin/infection --threads=8 --no-progress --only-covered -s || exit 0"
    }
}
